        "verified_sender_domain",
        "SPF",
        "DKIM",
        "DMARC"
      ],
      "oauth_requirements": [
        "registered_client",
        "exact_callback_allowlist",
        "scoped_encrypted_refresh_token_store"
      ],
      "health_status_contract": {
        "states": [
          "not_configured",
          "configured",
          "degraded",
          "unavailable"
