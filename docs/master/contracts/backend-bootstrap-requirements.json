      "purpose": "Default-off protected upload/finalize/proxy content",
      "required_when": null
    },
    {
      "name": "PRODUCT_DOCUMENT_MAINTENANCE_ENABLED",
      "purpose": "Default-off protected observed-byte verification and exact expired cleanup",
