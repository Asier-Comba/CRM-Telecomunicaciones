  "supabase": {
    "config": "supabase/config.toml",
    "postgrest_max_rows": 100,
    "auth": {
      "production_site_url": "environment-owned HTTPS application origin",
      "redirect_urls": "exact environment-owned allowlist; no wildcard",
      "local_oauth_enabled": false,
      "production_mail_provider": "auth-mail.primary",
      "mfa_production_verification": "W4/W5 requirement; not proven by local Auth"
    },
    "storage_buckets": [
      {
        "id": "telecom-documents",
        "public": false,
        "file_size_limit": "10MiB",
        "allowed_mime_types": [
          "application/pdf",
          "image/png",
          "image/jpeg"
        ]
      },
      {
        "id": "telecom-import-quarantine",
        "public": false,
        "file_size_limit": "10MiB",
        "allowed_mime_types": [
          "application/zip"
        ],
        "generic_zip_apply": "BLOCKED"
      }
    ]
  },
