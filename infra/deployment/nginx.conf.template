# Render APP_HOST from verified company configuration. Unknown hosts are rejected.
limit_req_zone $binary_remote_addr zone=crm_api:10m rate=10r/s;
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
log_format crm_meta '$status $request_time $upstream_response_time';
server { listen 80 default_server; server_name _; return 444; }
server {
  listen 443 ssl;
  server_name ${APP_HOST};
  if ($host != "${APP_HOST}") { return 444; }
  access_log ${NGINX_METADATA_LOG_PATH} crm_meta;
  # nginx diagnostic request URLs are not a permitted telemetry channel.
  error_log /dev/null crit;
  ssl_certificate ${TLS_CERT_PATH};
  ssl_certificate_key ${TLS_KEY_PATH};
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;
  client_max_body_size 10m;
  client_body_timeout 15s;
  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host ${APP_HOST};
    proxy_set_header X-Forwarded-Host ${APP_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 60s;
  }
  location /api/ {
    limit_req zone=crm_api burst=20 nodelay;
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host ${APP_HOST};
    proxy_set_header X-Forwarded-Host ${APP_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "private, no-store" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    proxy_cache off;
    proxy_read_timeout 120s;
    proxy_send_timeout 60s;
    proxy_connect_timeout 5s;
    proxy_buffering off;
  }
}
