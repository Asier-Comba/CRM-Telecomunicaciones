# Development-only synthetic telecom preview. Never copy these flags to a
# production environment. The preview assistant route also fails closed when
# NODE_ENV=production.
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
NEXT_PUBLIC_ENABLE_ASSISTANT=true
NEXT_PUBLIC_ENABLE_OPPORTUNITIES=true
NEXT_PUBLIC_ENABLE_CALENDAR=true
NEXT_PUBLIC_ENABLE_INVOICING=false
NEXT_PUBLIC_ENABLE_INBOX=false
NEXT_PUBLIC_ENABLE_AUTOMATIONS=false
NEXT_PUBLIC_FORCE_OFFLINE_DEV=false
