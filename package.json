{
  "name": "crm-telecomunicaciones",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "platform:verify": "node scripts/platform/platform.mjs verify",
    "platform:test": "node --test tests/platform/*.test.mjs",
    "platform:bootstrap:local": "node scripts/platform/platform.mjs bootstrap-local",
    "platform:acceptance": "node scripts/platform/platform.mjs acceptance",
    "platform:recovery:test": "node scripts/platform/platform.mjs recovery-test",
    "platform:preflight:staging": "node scripts/platform/platform.mjs preflight STAGING",
    "platform:preflight:prod": "node scripts/platform/platform.mjs preflight PROD",
    "platform:release": "node scripts/platform/platform.mjs release",
    "platform:company:report": "node scripts/platform/platform.mjs company-report",
    "preview:dev": "node scripts/preview-dev.mjs",
    "preview:check": "node --test tests/bootstrap/telecom-preview-gates.test.mjs && npm run typecheck && npm run test:e2e:preview",
    "dev": "next dev --webpack",
    "build": "next build",
    "prebuild": "node scripts/platform/build-public.mjs",
    "postbuild": "node scripts/platform/clean-build-cache.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/bootstrap/*.test.mjs",
    "test:db:onboarding": "npm --prefix scripts/security/ephemeral-postgres run test:onboarding",
    "test:db:domain": "npm --prefix scripts/security/ephemeral-postgres run test:domain",
    "test:db:rls": "node scripts/run-telecom-db-rls-test.mjs",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "audit:supabase-repro": "node scripts/audit-supabase-reproducibility.mjs",
    "audit:supabase-repro:strict": "node scripts/audit-supabase-reproducibility.mjs --strict",
    "test:e2e:legacy": "playwright test --config playwright.legacy.config.ts",
    "preview:doctor": "node scripts/preview-doctor.mjs",
    "preview:setup": "node scripts/preview-setup.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
